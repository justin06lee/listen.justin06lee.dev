# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode, from running design/favicon/generate.py
__pycache__/

# derived icons — built from app/icon.svg by scripts/build-icons.mjs, which
# predev and prebuild run. The SVG is the only icon committed; these two exist
# only because ICO and Apple touch icons cannot be vector.
/app/favicon.ico
/app/apple-icon.png
